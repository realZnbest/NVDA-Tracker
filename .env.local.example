FINNHUB_API_KEY=your_finnhub_api_key_here

# Optional: powers the "สรุปโดย AI" cards on the News and Financials pages.
# Only GEMINI_API_KEY is required; the rest are optional extra providers/keys that
# get tried in order (Gemini keys, then Groq keys, then OpenRouter keys) if an
# earlier one hits a free-tier rate limit. Add as many or as few as you want.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_BACKUP=
GEMINI_API_KEY_SECONDARY=
GEMINI_MODEL=gemini-3.5-flash

GROQ_API_KEY=
GROQ_API_KEY_BACKUP=
GROQ_MODEL=openai/gpt-oss-20b

OPENROUTER_API_KEY=
OPENROUTER_API_KEY_BACKUP=
OPENROUTER_MODEL=openai/gpt-oss-20b:free

# Required for the position/alerts edit gate (magic-link login) and for alert emails.
# Without these two set, the site still works fully as a read-only public dashboard —
# you just can't edit your position or alerts, and alerts won't be emailed (in-app only).
OWNER_EMAIL=you@example.com
RESEND_API_KEY=your_resend_api_key_here
# RESEND_FROM=NVDA Instrument Wall <onboarding@resend.dev>

# Optional but recommended once deployed: protects /api/alerts/check from being
# triggered by anyone on the public internet. Set the same value here and as the
# X-Cron-Secret header on your Render Cron Job (see README).
CRON_SECRET=
