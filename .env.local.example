FINNHUB_API_KEY=your_finnhub_api_key_here

# Required to view/manage alerts and notifications — this site is public (anyone with the
# link can open it), so alert rules and notification history are gated behind a single
# shared password. Pick any password; entering it once sets a signed cookie in your browser.
ALERTS_PASSWORD=choose_a_password

# Required for alerts (create/edit/delete + in-app notifications) to persist across
# Render redeploys — Render's filesystem is ephemeral, so a local SQLite file resets
# on every deploy. Create a free database at turso.tech, then run:
#   turso db show <db-name> --url          -> TURSO_DATABASE_URL
#   turso db tokens create <db-name>       -> TURSO_AUTH_TOKEN
# Tables are created automatically on first connect — no manual SQL step needed.
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Optional: powers the "สรุปโดย AI" cards on the News and Financials pages.
# Only GEMINI_API_KEY is required; the rest are optional extra providers/keys that
# get tried in order (Gemini keys, then Groq keys, then OpenRouter keys) if an
# earlier one hits a free-tier rate limit. Add as many or as few as you want.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_BACKUP=
GEMINI_API_KEY_SECONDARY=
GEMINI_MODEL=gemini-3.5-flash

GROQ_API_KEY=
GROQ_API_KEY_BACKUP=
GROQ_MODEL=openai/gpt-oss-20b

OPENROUTER_API_KEY=
OPENROUTER_API_KEY_BACKUP=
OPENROUTER_MODEL=openai/gpt-oss-20b:free

# Optional: email delivery when an alert fires, in addition to the in-app notification.
# Sign up free at resend.com (100 emails/day, no card required) and create an API key —
# no custom domain needed, since it sends from Resend's shared onboarding@resend.dev
# sender to your own address only. Without these two set, alerts still work fully in-app.
RESEND_API_KEY=
ALERT_EMAIL_TO=
